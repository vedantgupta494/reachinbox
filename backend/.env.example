# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_string
FRONTEND_URL=http://localhost:3000

# Database (Postgres via docker-compose)
DATABASE_URL="postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public"

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_EMAILS_INDEX=emails

# Ethereal Email (fake SMTP) - generate via https://ethereal.email/create
ETHEREAL_SMTP_HOST=smtp.ethereal.email
ETHEREAL_SMTP_PORT=587
ETHEREAL_SMTP_USER=your_ethereal_user@ethereal.email
ETHEREAL_SMTP_PASS=your_ethereal_password

# Rate limiting (configurable, no hardcoding)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MIN_DELAY_BETWEEN_SENDS_MS=2000
WORKER_CONCURRENCY=5

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Slack OAuth
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
